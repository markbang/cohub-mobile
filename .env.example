# Build-time default deployment. `dev` resolves to the dev API, gateway, and Logto app;
# `prod` (default) mirrors the production endpoints pinned in app.json.
# The login screen can switch environments and remembers the choice; see README.
EXPO_PUBLIC_COHUB_ENV=prod
# Optional per-endpoint overrides. Leave unset to inherit the environment above.
# EXPO_PUBLIC_API_ORIGIN=https://capi.neta.art
# EXPO_PUBLIC_GATEWAY_ORIGIN=wss://cgateway.neta.art/ws
# Dev defaults: https://capi-dev.neta.art and wss://cgateway-dev.neta.art/ws.
# EXPO_PUBLIC_AUTH_ENDPOINT=https://auth.neta.art/
# EXPO_PUBLIC_LOGTO_APP_ID=16ai0wao2mud3xqkbzqo0
# EXPO_PUBLIC_API_RESOURCE=https://api.talesofai
# Anonymous feedback + diagnostic log upload (cfeed).
# EXPO_PUBLIC_DIAGNOSTICS_ORIGIN=https://cfeed.neta.art
# Build-time Expo Updates protocol endpoint. Empty disables OTA.
# Production native builds use https://mobile.talesofai.com/manifest.
EXPO_PUBLIC_UPDATES_URL=
# HTTPS origin for in-app Android APK checks and downloads (Yaota). GitHub Releases still attach APKs.
EXPO_PUBLIC_APK_ORIGIN=
