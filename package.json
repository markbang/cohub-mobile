{
  "name": "cohub-mobile",
  "main": "expo-router/entry",
  "version": "2.2.9",
  "dependencies": {
    "@lobehub/icons-rn": "^2.13.1",
    "@logto/rn": "^1.3.0",
    "@neta-art/cohub": "^8.15.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-audio": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~58.0.0",
    "expo-device": "~58.0.0",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~58.0.0",
    "expo-image-picker": "~58.0.0",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-updates": "~58.0.0",
    "expo-web-browser": "~58.0.0",
    "js-base64": "^3.9.3",
    "lucide-react-native": "^1.40.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "shiki": "^4.4.3",
    "unicode-segmenter": "^0.17.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:workflow": "node --no-warnings --experimental-strip-types scripts/check-chat-workflow.mjs && node --no-warnings --experimental-strip-types scripts/check-ota-publish.mjs",
    "doctor": "expo-doctor",
    "diagnostics:server": "node scripts/diagnostics-server.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:workflow && node scripts/check-expo-go-notifications.mjs && npm run release:check && npm run doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "prebuild": "expo prebuild",
    "native:android": "npm run native:android:prepare && npm run native:android:build",
    "native:android:prepare": "npx expo prebuild --platform android --no-install",
    "native:android:build": "node scripts/build-android-debug.mjs",
    "native:android:distribution": "node scripts/build-android-distribution.mjs",
    "native:ios": "npm run native:ios:prepare && npm run native:ios:build",
    "native:ios:prepare": "npx expo prebuild --platform ios --no-install && pod install --project-directory=ios",
    "native:ios:build": "node scripts/build-ios-simulator.mjs",
    "native:android:release": "node scripts/build-android-release.mjs",
    "native:ios:release": "node scripts/build-ios-release.mjs"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "react-dom": "$react",
    "uuid": "^11.1.1"
  }
}
