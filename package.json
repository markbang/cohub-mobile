{
  "name": "cohub-mobile",
  "main": "expo-router/entry",
  "version": "2.3.1",
  "dependencies": {
    "@expo/ui": "~58.0.21",
    "@legendapp/list": "^3.6.0",
    "@lobehub/icons-rn": "^2.14.0",
    "@logto/rn": "^1.3.0",
    "@neta-art/cohub": "^12.5.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "culori": "^4.0.2",
    "expo": "~58.0.13",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.6",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "js-base64": "^3.9.4",
    "lucide-react-native": "^1.58.0",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "file:./modules/react-native-enriched-markdown",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "unicode-segmenter": "^0.17.3",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.21.4",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:workflow": "node --no-warnings --experimental-strip-types scripts/check-chat-workflow.mjs && node --no-warnings --experimental-strip-types scripts/check-ota-publish.mjs",
    "doctor": "node scripts/check-expo-baseline.mjs",
    "doctor:upstream": "expo-doctor",
    "diagnostics:server": "node scripts/diagnostics-server.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:workflow && node scripts/check-expo-go-notifications.mjs && npm run release:check && npm run doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "prebuild": "expo prebuild",
    "native:android": "npm run native:android:prepare && npm run native:android:build",
    "native:android:prepare": "npx expo prebuild --platform android --no-install",
    "native:android:build": "node scripts/build-android-debug.mjs",
    "native:android:distribution": "node scripts/build-android-distribution.mjs",
    "native:ios": "npm run native:ios:prepare && npm run native:ios:build",
    "native:ios:prepare": "npx expo prebuild --platform ios --no-install && pod install --project-directory=ios",
    "native:ios:build": "node scripts/build-ios-simulator.mjs",
    "native:android:release": "node scripts/build-android-release.mjs",
    "native:ios:release": "node scripts/build-ios-release.mjs"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "overrides": {
    "@logto/rn": {
      "expo-crypto": "$expo-crypto",
      "expo-secure-store": "$expo-secure-store",
      "expo-web-browser": "$expo-web-browser"
    },
    "decode-uri-component": "^0.5.0",
    "react-dom": "$react",
    "uuid": "^11.1.1"
  }
}
