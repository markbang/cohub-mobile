{
  "name": "cohub-mobile",
  "main": "expo-router/entry",
  "version": "2.3.16",
  "workspaces": [
    "modules/react-native-enriched-markdown",
    "modules/react-native-screens"
  ],
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@legendapp/list": "^3.6.0",
    "@lobehub/icons-rn": "^2.14.0",
    "@logto/rn": "^1.3.0",
    "@neta-art/cohub": "^13.26.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/react-query": "^5.105.0",
    "culori": "^4.0.2",
    "expo": "~58.0.19",
    "expo-application": "~58.1.1",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.6",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-paste-input": "^0.2.2",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "js-base64": "^3.9.4",
    "lucide-react-native": "^1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "workspace:*",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "workspace:*",
    "react-native-svg": "15.16.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "unicode-segmenter": "^0.17.3",
    "uniwind": "^1.12.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "~19.3.0",
    "eslint-plugin-expo": "1.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.21.5",
    "oxlint": "1.94.0",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "typecheck": "bun check --noUnusedLocals --noUnusedParameters",
    "test:workflow": "bun scripts/check-chat-workflow.mjs && bun scripts/check-ota-publish.mjs",
    "check:design-tokens": "bun scripts/design-tokens.mjs --check",
    "check:design-system": "bun scripts/check-design-system.mjs",
    "check:module-graph": "bun scripts/check-module-graph.mjs",
    "check:licenses": "bun scripts/open-source-licenses.mjs --check",
    "check:expo-go": "bun scripts/check-expo-go-notifications.mjs",
    "doctor": "node scripts/check-expo-baseline.mjs",
    "doctor:upstream": "expo-doctor",
    "diagnostics:server": "node scripts/diagnostics-server.mjs",
    "release:check": "node scripts/check-release.mjs",
    "verify": "bun run --parallel --no-exit-on-error lint typecheck test:workflow check:design-tokens check:design-system check:module-graph check:licenses check:expo-go release:check doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "prebuild": "expo prebuild",
    "native:android": "bun run native:android:prepare && bun run native:android:build",
    "native:android:prepare": "expo prebuild --platform android --no-install",
    "native:android:build": "node scripts/build-android-debug.mjs",
    "native:android:distribution": "node scripts/build-android-distribution.mjs",
    "native:ios": "bun run native:ios:prepare && bun run native:ios:build",
    "native:ios:prepare": "expo prebuild --platform ios --no-install && pod install --project-directory=ios",
    "native:ios:build": "node scripts/build-ios-simulator.mjs",
    "native:android:release": "node scripts/build-android-release.mjs",
    "native:ios:release": "node scripts/build-ios-release.mjs"
  },
  "private": true,
  "packageManager": "bun@1.4.3",
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "react-dom": "$react",
    "uuid": "^11.1.1"
  }
}
