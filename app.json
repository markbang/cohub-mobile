{
  "expo": {
    "name": "Cohub",
    "slug": "cohub-mobile",
    "version": "2.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cohub",
    "userInterfaceStyle": "automatic",
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.markbang.cohubmobile",
      "associatedDomains": [
        "applinks:cohub.live"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cohub uses the camera to attach references to a Chat, and lets Works you approve use it.",
        "NSMicrophoneUsageDescription": "Cohub uses the microphone for voice input, and lets Works you approve use it.",
        "NSPhotoLibraryUsageDescription": "Cohub uses your photo library to attach references to a Chat."
      },
      "icon": "./assets/images/cohub.icon"
    },
    "android": {
      "package": "io.github.markbang.cohubmobile",
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cohub.live",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#fa7b23"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cohub uses your photos to attach references to a Chat.",
          "cameraPermission": "Cohub uses the camera to attach references to a Chat, and lets Works you approve use it."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "./modules/cohub-device-runtime/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mascot.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f3ee",
          "dark": {
            "image": "./assets/images/splash-mascot.png",
            "backgroundColor": "#0c0a09"
          }
        }
      ]
    ],
    "extra": {
      "apiOrigin": "https://capi.neta.art",
      "gatewayOrigin": "wss://cgateway.neta.art/ws",
      "authEndpoint": "https://auth.neta.art/",
      "logtoAppId": "16ai0wao2mud3xqkbzqo0",
      "apiResource": "https://api.talesofai",
      "environment": "prod"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
