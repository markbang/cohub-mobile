<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Agents work on the folder the user binds, anywhere in shared storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Sharing this screen with a Space the device serves. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <service
            android:name="io.github.markbang.cohubmobile.deviceruntime.RuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's Cohub Runtime connected so their agents can work on files in this device's storage." />
        </service>

        <!-- Lets a Space steer this screen while it is shared: gestures, text, system buttons and elements. -->
        <service
            android:name="io.github.markbang.cohubmobile.deviceruntime.display.ControlService"
            android:enabled="@bool/cohub_display_control_enabled"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cohub_control_service" />
        </service>
    </application>
</manifest>
