<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Agents work on the folder the user binds, anywhere in shared storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Sharing this screen with a Space the device serves. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Phone control keeps Accessibility on once its helper granted this. Local network access needs no
         permission below target SDK 37; add ACCESS_LOCAL_NETWORK with that bump (see PhoneControl.localNetwork). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Agents launch apps on their own screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name="io.github.markbang.cohubmobile.deviceruntime.RuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's Cohub Runtime connected so their agents can work on files in this device's storage." />
        </service>

        <!-- Lets a Space steer this screen while it is shared: gestures, text, system buttons and elements. -->
        <service
            android:name="io.github.markbang.cohubmobile.deviceruntime.display.ControlService"
            android:enabled="@bool/cohub_display_control_enabled"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cohub_control_service" />
        </service>

        <!-- The phone control helper, started as the shell user, hands its binder over here; only the shell may call it. -->
        <provider
            android:name="io.github.markbang.cohubmobile.deviceruntime.helper.HelperHandoff"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name="io.github.markbang.cohubmobile.deviceruntime.helper.PhoneControl$PairingReceiver"
            android:exported="false" />
        <receiver
            android:name="io.github.markbang.cohubmobile.deviceruntime.helper.PhoneControl$HandoverReceiver"
            android:exported="false" />
    </application>
</manifest>
